SUPABASE_URL=https://supabase.example.ke
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.ke
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

MPESA_CONSUMER_KEY=replace-with-consumer-key
MPESA_CONSUMER_SECRET=replace-with-consumer-secret
MPESA_PASSKEY=replace-with-passkey
MPESA_SHORTCODE=replace-with-paybill-shortcode
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_BASE_URL=https://api.example.ke
CALLBACK_BASE_URL=https://api.example.ke
MPESA_CALLBACK_SECRET=replace-with-callback-signing-secret
ALLOW_UNSIGNED_MPESA_CALLBACKS=false
NEXT_PUBLIC_MPESA_PAYBILL=replace-with-paybill-number

# Internal service routing. Both the web app and the edge gateway call the same
# M-PESA worker; every call must carry the caller's Supabase access token.
API_BASE_URL=https://api.example.ke
NEXT_PUBLIC_API_BASE_URL=https://api.example.ke
INTERNAL_API_BASE_URL=https://api.example.ke
UPSTREAM_BASE_URL=https://api.example.ke
GATEWAY_UPSTREAM_SECRET=replace-with-edge-to-service-secret
GATEWAY_INTERNAL_SECRET=replace-with-internal-calls-secret
RATE_LIMITER=rate-limiter-binding
RATE_LIMIT_KV=rate-limit-kv-binding
ALLOWED_ORIGIN=https://www.afyacommerce.co.ke

# Rider dispatch. OTP dispatch fails closed when the secret or the SMS queue is
# missing, so both are required before accepting rider sign-ins.
DISPATCH_API_TOKEN=replace-with-dispatch-service-token
DISPATCH_OTP_SECRET=replace-with-dispatch-otp-signing-secret
DISPATCH_EVENTS=dispatch-events-binding
SMS_QUEUE=sms-queue-binding
PROOF_STORAGE_BUCKET=delivery-proof

AT_API_KEY=replace-with-africas-talking-key
AT_USERNAME=afyacommerce
AT_SENDER_ID=AFYACOMMERCE

HIE_BASE_URL=https://hie.example.ke/api
HIE_CLIENT_ID=replace-with-hie-client-id
HIE_CLIENT_SECRET=replace-with-hie-client-secret

SHA_API_BASE_URL=https://afyayangu.example.ke/api
SHA_CLIENT_ID=replace-with-sha-client-id
SHA_CLIENT_SECRET=replace-with-sha-client-secret

CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-api-token
CLOUDFLARE_R2_BUCKET=afyacommerce-assets

JWT_SECRET=replace-with-256-bit-secret
AUDIT_LOG_RETENTION_DAYS=2190
ODPC_REGISTRATION_NUMBER=replace-with-odpc-number
PPB_LICENCE_NUMBER=replace-with-ppb-licence
KMHFR_FACILITY_ID=replace-with-kmhfr-id
DHA_CERTIFICATION_ID=replace-with-dha-certification-id
CONSENT_POLICY_VERSION=1.0.0

NEXT_PUBLIC_MAPS_PROVIDER=maplibre
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.ke/{z}/{x}/{y}.png

NEXT_PUBLIC_ENABLE_USSD_FALLBACK=true
NEXT_PUBLIC_ENABLE_SHA_CLAIMS=true
NEXT_PUBLIC_LOW_BANDWIDTH_DEFAULT=false
